#!/bin/bash
set -euo pipefail

APP_NAME="${APP_NAME:-vocare-grc-bot}"
RESOURCE_GROUP="${RESOURCE_GROUP:-vocare-grc}"
ENV_FILE="${ENV_FILE:-.env}"

usage() {
  cat <<EOF
Usage: ./changeLLM <provider> [model] [--azure-only|--local-only]
       ./changeLLM <provider> [model] --key <api-key>

Examples:
  ./changeLLM openai gpt-4o-mini
  ./changeLLM azure gpt-5.4-mini --key "$AZURE_OPENAI_API_KEY"
  ./changeLLM cerebras gpt-oss-120b
  ./changeLLM deepseek deepseek-v4-pro
  ./changeLLM cerebras gpt-oss-120b --key "\$CEREBRAS_API_KEY"

Environment overrides:
  APP_NAME=$APP_NAME
  RESOURCE_GROUP=$RESOURCE_GROUP
  ENV_FILE=$ENV_FILE
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

PROVIDER=""
MODEL=""
KEY_VALUE=""
UPDATE_AZURE=true
UPDATE_LOCAL=true
RESTART_APP=false
SHOW_CONFIG=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --azure-only)
      UPDATE_LOCAL=false
      shift
      ;;
    --local-only)
      UPDATE_AZURE=false
      shift
      ;;
    --restart)
      RESTART_APP=true
      shift
      ;;
    --no-show)
      SHOW_CONFIG=false
      shift
      ;;
    --key)
      shift
      KEY_VALUE="${1:-}"
      if [[ -z "$KEY_VALUE" ]]; then
        echo "--key requires a value" >&2
        exit 1
      fi
      shift
      ;;
    *)
      if [[ -z "$PROVIDER" ]]; then
        PROVIDER="$1"
      elif [[ -z "$MODEL" ]]; then
        MODEL="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
        exit 1
      fi
      shift
      ;;
  esac
done

PROVIDER="$(printf '%s' "$PROVIDER" | tr '[:upper:]' '[:lower:]')"
case "$PROVIDER" in
  openai|azure|azure_openai|foundry|cerebras|groq|mistral|deepseek) ;;
  *)
    echo "Unsupported provider: $PROVIDER" >&2
    echo "Supported providers: openai, azure, azure_openai, foundry, cerebras, groq, mistral, deepseek" >&2
    exit 1
    ;;
esac

if [[ -z "$MODEL" ]]; then
  case "$PROVIDER" in
    openai) MODEL="gpt-4o-mini" ;;
    azure|azure_openai|foundry) MODEL="gpt-5.4-mini" ;;
    cerebras) MODEL="gpt-oss-120b" ;;
    deepseek) MODEL="deepseek-v4-pro" ;;
    groq|mistral)
      echo "Please provide a model for $PROVIDER." >&2
      exit 1
      ;;
  esac
fi

set_env_file_value() {
  local key="$1"
  local value="$2"
  touch "$ENV_FILE"
  if grep -q "^${key}=" "$ENV_FILE"; then
    python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]
lines = path.read_text().splitlines()
for idx, line in enumerate(lines):
    if line.startswith(f"{key}="):
        lines[idx] = f"{key}={value}"
        break
path.write_text("\n".join(lines) + "\n")
PY
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

if [[ "$UPDATE_LOCAL" == true ]]; then
  set_env_file_value LLM_PROVIDER "$PROVIDER"
  set_env_file_value LLM_MODEL "$MODEL"
  echo "Updated $ENV_FILE: LLM_PROVIDER=$PROVIDER, LLM_MODEL=$MODEL"
fi

if [[ "$UPDATE_AZURE" == true ]]; then
  if [[ -n "$KEY_VALUE" ]]; then
    ./setLLMKey "$PROVIDER" "$KEY_VALUE"
  fi

  AZURE_ENDPOINT_ARGS=()
  if [[ "$PROVIDER" == "azure" || "$PROVIDER" == "azure_openai" || "$PROVIDER" == "foundry" ]]; then
    ENDPOINT_VALUE="${AZURE_OPENAI_ENDPOINT:-${AZURE_AI_FOUNDRY_ENDPOINT:-}}"
    if [[ -z "$ENDPOINT_VALUE" && -f "$ENV_FILE" ]]; then
      ENDPOINT_VALUE="$(grep -E "^(AZURE_OPENAI_ENDPOINT|AZURE_AI_FOUNDRY_ENDPOINT)=" "$ENV_FILE" | tail -n 1 | cut -d= -f2-)"
    fi
    if [[ -n "$ENDPOINT_VALUE" ]]; then
      AZURE_ENDPOINT_ARGS+=(AZURE_OPENAI_ENDPOINT="$ENDPOINT_VALUE")
    else
      echo "Warning: AZURE_OPENAI_ENDPOINT not set. Configure it before using provider=$PROVIDER." >&2
    fi
  fi

  echo "Updating Azure Container App $APP_NAME in $RESOURCE_GROUP..."
  az containerapp update \
    --name "$APP_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --set-env-vars \
      LLM_PROVIDER="$PROVIDER" \
      LLM_MODEL="$MODEL" \
      "${AZURE_ENDPOINT_ARGS[@]}"
  echo "Azure LLM config updated."

  if [[ "$RESTART_APP" == true ]]; then
    echo "Restarting active revision..."
    az containerapp revision restart \
      --name "$APP_NAME" \
      --resource-group "$RESOURCE_GROUP"
  fi

  if [[ "$SHOW_CONFIG" == true ]]; then
    ./showLLM
  fi
fi

echo "Current selection: $PROVIDER / $MODEL"
