#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/.venv-voice-tests"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "Creating voice test virtualenv at $VENV"
  python3 -m venv "$VENV"
fi

"$VENV/bin/pip" install -q -r "$ROOT/voice_tests/requirements.txt"
"$VENV/bin/python" "$ROOT/voice_tests/run_voice_tests.py" "$@"
