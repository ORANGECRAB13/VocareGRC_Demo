# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / Capacitor
node_modules/

# Apple build and user state
ios/**/build/
ios/**/xcuserdata/
ios/**/.swiftpm/
DerivedData/

# Local databases and logs
*.db
*.sqlite*
*.log

# Editors and operating systems
.DS_Store
.idea/
.vscode/

.tools/

# Native app build artefacts (native/ios, native/android)
# SwiftPM resolves WebRTC + GoogleMobileAds xcframeworks into .build (~134MB).
native/ios/**/.build/
native/ios/**/.swiftpm/
native/ios/**/xcuserdata/
native/**/DerivedData/
