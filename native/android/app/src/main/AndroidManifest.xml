<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      No com.android.vending.BILLING permission while BuildConfig.PAID_TIER_ENABLED
      is false: this build sells nothing, has no paywall and no products in Play
      Console, and a declared billing permission with no in-app products is what
      review flags. The Play Billing library declares it in its own manifest, so
      it has to be removed at merge; drop tools:node="remove" at the same time as
      creating the Play Console subscription — see native/android/README.md,
      "Turning the paid tier on".
    -->
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />
    <!--
      No advertising-id permission and no AdMob meta-data: the free build does not
      link play-services-ads at all (app/build.gradle.kts), so nothing merges
      com.google.android.gms.permission.AD_ID in and there is no init
      ContentProvider to satisfy. The published privacy policy promises exactly
      this. Restoring ads means dependency + APPLICATION_ID meta-data + AD_ID +
      the Data Safety declaration + a policy update, together — see
      native/android/README.md.
    -->

    <!-- Offline STT: let the app see which recognition services exist on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".VocaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voca">

        <!-- Sample id by default; the real id comes from VOCARE_ADMOB_ANDROID_APP_ID at build time. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
