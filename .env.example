TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=
TRANSFER_PHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_TTS_SPEED=1.0
ELEVENLABS_TTS_STABILITY=0.35
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_EN_STABILITY=0.35
ELEVENLABS_TTS_ZH_STABILITY=0.55
WASTETRACK_TIMEOUT_SECS=5
HESITATION_FILLER_HOLDOFF_SECS=1.4
HESITATION_PARTIAL_HOLDOFF_SECS=1.6
HESITATION_WAIT_HOLDOFF_SECS=2.6
UNIFIED_AGENT_ID=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
OPENAI_API=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://vocare-resource.services.ai.azure.com/openai/v1
AZURE_MODEL=gpt-5.4-mini
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_TYPE=enabled
DEEPSEEK_REASONING_EFFORT=max
TELNYX_API_KEY=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_PHONE_NUMBER=
PUBLIC_URL_TELNYX=
LIVE_CALL_STATE_BACKEND=memory
LIVE_CALL_REDIS_URL=
LIVE_CALL_REDIS_PREFIX=vocare:livecalls
LIVE_CALL_LIMIT=500
LIVE_CALL_STATE_TTL_SECS=21600
LIVE_CALL_REDIS_CONNECT_TIMEOUT_SECS=2
LIVE_CALL_REDIS_TIMEOUT_SECS=2
LIVE_CALL_REDIS_ALLOW_INSECURE=false

# LiveKit voice agent
LIVEKIT_URL=ws://localhost:7900
LIVEKIT_PUBLIC_URL=ws://localhost:7900
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Local machine address advertised for browser/container ICE. On macOS:
# ipconfig getifaddr en0
LIVEKIT_NODE_IP=
AGENT_NAME=utilities10x-agent
AGENT_WEBRTC_RELAY_ONLY=false
LIVEKIT_STT_MODEL=scribe_v2_realtime
# Blank enables multilingual auto-detection.
LIVEKIT_STT_LANGUAGE_CODE=
LIVEKIT_STT_VAD_SILENCE_SECS=0.3

# Cached LLM end-of-turn detection. COMPLETE verdicts can use the fast lane to
# commit a stable transcript before local Silero VAD reports silence. VAD remains
# the fallback for incomplete, uncertain, or failed classifications.
EOT_ENABLED=false
EOT_MODEL=gpt-oss-120b
EOT_API_KEY=
EOT_BASE_URL=
EOT_CHAT_URL=
EOT_TOKEN_PARAM=
EOT_REASONING_EFFORT=low
EOT_TIMEOUT_SECONDS=4
EOT_CLASSIFY_DEBOUNCE_MS=150
EOT_COMPLETE_THRESHOLD=0.98
EOT_FAST_LANE_ENABLED=true
EOT_FAST_LANE_STABILITY_MS=800
EOT_FAST_LANE_MIN_WORDS=3
EOT_FAST_LANE_TRANSCRIPT_TIMEOUT_SECONDS=0.8
EOT_CONTEXT_FILLER_ENABLED=true
EOT_LATE_FILLER_WINDOW_SECONDS=1.5
LIVEKIT_TTS_MODEL=eleven_flash_v2_5
LIVEKIT_LLM_MAX_TOKENS=220
LLM_REASONING_EFFORT=none
LIVEKIT_MIN_ENDPOINTING_DELAY=0.05
LIVEKIT_MAX_ENDPOINTING_DELAY=0.6
LIVEKIT_PREEMPTIVE_GENERATION=true
LIVEKIT_ALLOW_INTERRUPTION=true
LIVEKIT_NUM_IDLE_PROCESSES=1
LIVEKIT_GREETING_DELAY_SECS=0.3
LIVEKIT_BACKGROUND_AUDIO=true
LIVEKIT_BACKGROUND_AUDIO_VOLUME=1.0
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_8000
ELEVENLABS_TTS_AUTO_MODE=true
ELEVENLABS_TTS_SYNC_ALIGNMENT=false
ELEVENLABS_TTS_APPLY_TEXT_NORMALIZATION=off
ELEVENLABS_TTS_ENABLE_LOGGING=true
ELEVENLABS_TTS_USE_SPEAKER_BOOST=false
ELEVENLABS_TTS_INACTIVITY_TIMEOUT=60
