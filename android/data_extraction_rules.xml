<?xml version="1.0" encoding="utf-8"?>
<!--
  android:dataExtractionRules — used on Android 12 and above (API 31+).

  The translation history database is excluded from BOTH cloud backup and
  device-to-device transfer, so stored conversation transcripts never leave the
  device by either path. Everything else (preferences, WebView data) keeps the
  platform default behaviour.

  Filenames must stay in sync with
  TranslationHistoryDatabase.DATABASE_NAME.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vocare_translation_history.db" />
        <exclude domain="database" path="vocare_translation_history.db-wal" />
        <exclude domain="database" path="vocare_translation_history.db-shm" />
        <exclude domain="database" path="vocare_translation_history.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vocare_translation_history.db" />
        <exclude domain="database" path="vocare_translation_history.db-wal" />
        <exclude domain="database" path="vocare_translation_history.db-shm" />
        <exclude domain="database" path="vocare_translation_history.db-journal" />
    </device-transfer>
</data-extraction-rules>
