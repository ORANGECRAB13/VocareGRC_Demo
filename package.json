{
  "name": "vocare-translate-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS and Android shell for Vocare Translate",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "verify:www": "node scripts/build-www.mjs --check",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build:www && cap sync ios",
    "ios:open": "cap open ios",
    "android:add": "cap add android",
    "android:sync": "npm run build:www && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build:www && cap run android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-mlkit/translation": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capgo/capacitor-speech-recognition": "^8.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
